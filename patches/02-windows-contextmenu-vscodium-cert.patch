+procedure TrustAppxPackageCertificate();
+var
+  TrustCertificateResultCode: Integer;
+begin
+  Log('Trusting the VSCodium Explorer context menu certificate.');
+#if "user" == InstallTarget
+  ShellExec('', 'powershell.exe', '-NoLogo -NoProfile -NonInteractive -WindowStyle Hidden -ExecutionPolicy Bypass -Command ' + AddQuotes('Import-Certificate -FilePath ''' + ExpandConstant('{app}\{#VersionedResourcesFolder}\appx\{#AppxPackageCertificate}') + ''' -CertStoreLocation ''Cert:\CurrentUser\TrustedPeople'' | Out-Null'), '', SW_HIDE, ewWaitUntilTerminated, TrustCertificateResultCode);
