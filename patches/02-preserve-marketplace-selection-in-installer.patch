 [Code]
+var
+  MarketplaceBackupPath: String;
+
+procedure CaptureMarketplace;
+var
+  ProductJsonPath: String;
+begin
+  ProductJsonPath := ExpandConstant('{code:GetDestDir}\{#VersionedResourcesFolder}\resources\app\product.json');
+  MarketplaceBackupPath := ExpandConstant('{tmp}\vscodium-product-before-install.json');
+  if FileExists(ProductJsonPath) then begin
+    DeleteFile(MarketplaceBackupPath);
+    if FileCopy(ProductJsonPath, MarketplaceBackupPath, False) then
+      Log('Saved existing product.json for Marketplace preservation.')
+    else
+      Log('Could not save existing product.json; keeping packaged Marketplace configuration.');
+  end;
+end;
+
+procedure RestoreMarketplace;
+var
+  ProductJsonPath: String;
+  PowerShellPath: String;
+  Parameters: String;
+  ResultCode: Integer;
+begin
+  if not FileExists(MarketplaceBackupPath) then exit;
+
+  ProductJsonPath := ExpandConstant('{code:GetDestDir}\{#VersionedResourcesFolder}\resources\app\product.json');
+  ExtractTemporaryFile('vscodium-preserve-marketplace-selection.ps1');
+  PowerShellPath := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
+  Parameters := '-NoLogo -NoProfile -NonInteractive -ExecutionPolicy Bypass -File ' + AddQuotes(ExpandConstant('{tmp}\vscodium-preserve-marketplace-selection.ps1')) + ' -PreviousProduct ' + AddQuotes(MarketplaceBackupPath) + ' -InstalledProduct ' + AddQuotes(ProductJsonPath);
+
+  if not Exec(PowerShellPath, Parameters, '', SW_HIDE, ewWaitUntilTerminated, ResultCode) then
+    Log('Marketplace preservation script could not be started.')
+  else if ResultCode <> 0 then
+    Log('Marketplace preservation script exited with code ' + IntToStr(ResultCode) + '.')
+  else
+    Log('Marketplace selection preservation completed.');
+
+  DeleteFile(MarketplaceBackupPath);
+end;
+
 // Imports MultiByteToWideChar to decode UTF-8 bytes (LoadStringFromFile returns raw bytes) into a Unicode string.
